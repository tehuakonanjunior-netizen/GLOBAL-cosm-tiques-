:root{
  --clay: #B0785A;
  --clay-dark: #8C5A3F;
  --ink: #2B2622;
  --paper: #FBF7F2;
  --sage: #6E7A5E;
  --line: #E4DCD1;
}

*{ box-sizing: border-box; }

body{
  margin:0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'Manrope', sans-serif;
  line-height: 1.6;
}

h1,h2,h3{
  font-family: 'Fraunces', serif;
  font-weight: 600;
  margin: 0;
  color: var(--ink);
}

a{ color: inherit; }

/* Nav */
.nav{
  position: sticky; top:0; z-index: 10;
  background: rgba(251,247,242,0.9);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line);
}
.nav-inner{
  max-width: 1100px; margin: 0 auto;
  padding: 18px 24px;
  display:flex; justify-content: space-between; align-items:center;
}
.brand{ font-family:'Fraunces', serif; font-size: 1.1rem; }
.brand em{ font-style: normal; color: var(--clay-dark); }
.nav-links a{
  text-decoration:none; margin-left: 28px; font-size: 0.95rem;
}
.nav-links a:hover{ color: var(--clay-dark); }

/* Hero */
.hero{
  max-width: 1100px; margin: 0 auto;
  padding: 80px 24px 60px;
  display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px;
  align-items: center;
}
.hero h1{
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.15;
  max-width: 14ch;
}
.hero-sub{
  max-width: 42ch; color: #5A5248; margin-top: 20px;
}
.cta{
  display:inline-block; margin-top: 28px;
  padding: 14px 28px; border-radius: 2px;
  background: var(--clay); color: white;
  text-decoration:none; font-weight: 500;
  transition: background 0.2s ease;
}
.cta:hover{ background: var(--clay-dark); }
.cta-dark{ background: var(--ink); }
.cta-dark:hover{ background: #000; }

.hero-visual{ display:flex; justify-content:center; }
.drop{
  width: 220px; height: 280px;
  background: linear-gradient(160deg, var(--clay) 0%, var(--sage) 100%);
  border-radius: 50% 50% 48% 48% / 60% 60% 40% 40%;
  box-shadow: 0 30px 60px -20px rgba(140,90,63,0.4);
}

/* Sections */
.section{ max-width: 1100px; margin: 0 auto; padding: 70px 24px; }
.section h2{ font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 40px; }

/* Soins */
.cards{ display:grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.card{
  background: white; border: 1px solid var(--line);
  padding: 28px; border-radius: 4px;
}
.card .num{
  font-size: 0.85rem; color: var(--clay-dark); font-weight: 700;
  letter-spacing: 0.02em;
}
.card h3{ font-size: 1.2rem; margin: 10px 0 12px; }
.card p{ margin:0; color: #5A5248; font-size: 0.95rem; }

/* Matieres */
.matieres{ background: #F1EBE1; }
.matieres-text{ max-width: 640px; }
.matieres-text p{ color: #5A5248; }
.matieres-text ul{ padding-left: 20px; color: #4A443B; }
.matieres-text li{ margin-bottom: 8px; }

/* Contact */
.contact{ text-align: center; }
.contact p{ color: #5A5248; margin: 12px 0 8px; }

/* Footer */
.footer{
  border-top: 1px solid var(--line);
  padding: 24px; text-align:center;
  font-size: 0.85rem; color: #8A8175;
}

/* Responsive */
@media (max-width: 760px){
  .hero{ grid-template-columns: 1fr; padding-top: 50px; }
  .hero-visual{ order:-1; }
  .drop{ width: 160px; height: 200px; }
  .cards{ grid-template-columns: 1fr; }
  .nav-links a{ margin-left: 16px; font-size: 0.85rem; }
}